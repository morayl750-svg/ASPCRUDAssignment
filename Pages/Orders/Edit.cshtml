@page
@model ASPCRUDAssignment.Pages.Orders.EditModel
@{
    ViewData["Title"] = "Edit Order";
}

<h1>Edit Order</h1>

<div class="row">
    <div class="col-md-4">
        <form method="post">
            <!-- Waa muhiim in Id-ga iyo Taariikhda la qariyo si aysan u lumin -->
            <input type="hidden" asp-for="Order.Id" />
            <input type="hidden" asp-for="Order.OrderDate" />
            
            <div class="form-group mb-3">
                <label>Customer Name</label>
                <input asp-for="Order.CustomerName" class="form-control" required />
            </div>
            <div class="form-group mb-3">
                <label>Product Name</label>
                <input asp-for="Order.ProductName" class="form-control" required />
            </div>
            <div class="form-group mb-3">
                <label>Quantity</label>
                <input asp-for="Order.Quantity" class="form-control" required />
            </div>
            <div class="form-group mb-3">
                <label>Price</label>
                <input asp-for="Order.Price" class="form-control" required />
            </div>
            
            <button type="submit" class="btn btn-warning">Update</button>
            <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
        </form>
    </div>
</div>