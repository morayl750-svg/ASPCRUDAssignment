@page
@model ASPCRUDAssignment.Pages.Orders.DeleteModel
@{
    ViewData["Title"] = "Delete Order";
}

<h1>Delete Order</h1>

<h3 class="text-danger">Are you sure you want to delete this?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Customer Name</dt>
        <dd class="col-sm-9">@Model.Order.CustomerName</dd>
        
        <dt class="col-sm-3">Product Name</dt>
        <dd class="col-sm-9">@Model.Order.ProductName</dd>
        
        <dt class="col-sm-3">Quantity</dt>
        <dd class="col-sm-9">@Model.Order.Quantity</dd>
        
        <dt class="col-sm-3">Price</dt>
        <dd class="col-sm-9">@Model.Order.Price</dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="Order.Id" />
        <button type="submit" class="btn btn-danger">Yes, Delete</button>
        <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>